{
  "info": {
    "name": "JSONPlaceholder users",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET user by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Content-Type is JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
              "pm.test(\"Response time < 2000 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
              "const user = pm.response.json();",
              "pm.test(\"JSON has required fields\", function () {",
              "    [\"id\",\"name\",\"username\",\"email\",\"address\",\"phone\",\"company\"].forEach(k => pm.expect(user).to.have.property(k));",
              "});",
              "pm.test(\"id is 1 and name is Leanne Graham\", function () {",
              "    pm.expect(user.id).to.eql(1);",
              "    pm.expect(user.name).to.eql(\"Leanne Graham\");",
              "});",
              "pm.test(\"email looks like an email\", function () { pm.expect(user.email).to.include(\"@\"); });",
              "pm.test(\"address has street, city, zipcode, geo\", function () {",
              "    pm.expect(user.address).to.include.all.keys(\"street\",\"city\",\"zipcode\",\"geo\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "1"
          ]
        }
      }
    },
    {
      "name": "POST create user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test(\"id is assigned (number)\", function () { pm.expect(body.id).to.be.a(\"number\"); });",
              "pm.test(\"Sent fields are echoed back\", function () {",
              "    let sent = null;",
              "    try {",
              "        const raw = pm.request.body && (pm.request.body.raw || pm.request.body.toString());",
              "        if (raw) sent = JSON.parse(raw);",
              "    } catch (e) {}",
              "    if (!sent) {",
              "        sent = { \"name\": \"Вадим Потапов\", \"username\": \"vadim\", \"email\": \"vadim@example.com\" };",
              "    }",
              "    Object.keys(sent).forEach(k => pm.expect(body[k]).to.eql(sent[k]));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Вадим Потапов\",\n  \"username\": \"vadim\",\n  \"email\": \"vadim@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "PUT update user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test(\"id stays 1\", function () { pm.expect(body.id).to.eql(1); });",
              "pm.test(\"email was updated\", function () { pm.expect(body.email).to.eql(\"new@example.com\"); });",
              "pm.test(\"name was updated\", function () { pm.expect(body.name).to.eql(\"Вадим Потапов\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Вадим Потапов\",\n  \"username\": \"vadim\",\n  \"email\": \"new@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com"
    }
  ]
}